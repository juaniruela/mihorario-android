<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_widget"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/cabecera_widget"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/btAnterior"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:contentDescription="@string/dia_anterior"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCab"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Mi horario"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btSiguiente"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:contentDescription="@string/dia_siguiente"
            android:gravity="center"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- 1.11: abrir la app (tocar el contenido del widget ya no la abre) -->
        <ImageView
            android:id="@+id/btAbrir"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Abrir la app"
            android:padding="8dp"
            android:src="@drawable/ic_abrir" />

        <ImageView
            android:id="@+id/btRefrescar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/actualizar"
            android:padding="8dp"
            android:src="@drawable/ic_refrescar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <!-- 1.4: avisos del día en una línea que se desplaza sola (sin el número de actividades) -->
        <TextView
            android:id="@+id/tvAvisos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_aviso"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textColor="@color/aviso_texto"
            android:textSize="11sp"
            android:duplicateParentState="true">
            <!-- 1.6: siempre visible y con el foco, para que se desplace sin parar -->
            <requestFocus
                android:duplicateParentState="true"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </TextView>

        <!-- 1.2: la lista del día (actividades, turnos, tareas, bajas) se desplaza si no cabe -->
        <ListView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/vacia"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/sin_datos"
            android:textColor="@color/suave"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 6.08: abajo, a la izquierda la versión de la app; a la derecha la hora de actualización -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/suave"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/suave"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
