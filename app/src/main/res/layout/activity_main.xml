<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <!-- 1.5: tres pantallas: Día (ventana del widget), Tareas y Servicios (la app web completa) -->
    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <WebView
        android:id="@+id/webTar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <WebView
        android:id="@+id/webSer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 1.11: Centro: la app web completa de profesorado y tutoría (Horarios, Ahora, Coches, Mi cuenta…) -->
    <WebView
        android:id="@+id/webCen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 1.7: botón flotante FlashWork. 1.8: en todas las pantallas y arrastrable. 1.9: con el buscador al lado -->
    <LinearLayout
        android:id="@+id/fabs"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:background="@drawable/fondo_fab"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/fabBus"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Buscar alumnos, profesores, grupos, agenda o ir a una pantalla"
            android:gravity="center"
            android:text="🔍"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:background="#66FFFFFF" />

        <TextView
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="FlashWork: tarea o nota por voz"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="12dp"
            android:text="🎤 FlashWork"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/carga"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/config"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_config"
                android:textColor="@color/verde"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ayuda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/texto"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="https://…/widget.php?k=…"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:minHeight="48dp"
                android:textColor="@color/texto"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btPegar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pegar" />

                <Button
                    android:id="@+id/btGuardar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/verde"
                    android:text="@string/guardar"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

    <!-- barra inferior -->
    <LinearLayout
        android:id="@+id/barra"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/verde_oscuro"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tabCen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🏫\nCentro"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabDia"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📅\nDía"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabTar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="✅\nTareas"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabSer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🛠️\nServicios"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />


        <TextView
            android:id="@+id/tabMas"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:alpha="0.8"
            android:gravity="center"
            android:text="⋯\nMás"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
